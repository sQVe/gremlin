{
  "name": "gremlin",
  "version": "0.0.0",
  "private": true,
  "description": "Terminal UI for GitHub work that needs action.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "changeset": "changeset",
    "changeset:check": "changeset status --since=origin/main",
    "changeset:version": "changeset version && vp fmt",
    "check": "pnpm typecheck && pnpm style:check && pnpm format:check && pnpm knip && pnpm test",
    "fix": "vp lint --fix && vp fmt",
    "knip": "knip",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --deny-warnings",
    "style:check": "node scripts/runStyle.ts",
    "style:fix": "node scripts/runStyle.ts --fix",
    "prepare": "vp config",
    "test": "vp test",
    "test:changed": "vp test --changed",
    "typecheck": "pnpm exec tsc --noEmit",
    "release:github": "pnpm changeset tag"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.2",
    "@oxlint/plugins": "1.79.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.13.3",
    "jiti": "2.7.0",
    "knip": "6.37.0",
    "typescript": "7.0.2",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.3.4"
}
